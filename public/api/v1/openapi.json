{
  "openapi": "3.0.3",
  "info": {
    "title": "Nabz-e Farda internal data",
    "description": "Internal static JSON snapshots used by the site (ops/search). Not a public product API.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://nabz-farda.vercel.app/api/v1"
    }
  ],
  "paths": {
    "/latest.json": {
      "get": {
        "summary": "Latest day items",
        "responses": {
          "200": {
            "description": "Today's (or newest) articles summary"
          }
        }
      }
    },
    "/archive.json": {
      "get": {
        "summary": "Archive day index",
        "responses": {
          "200": {
            "description": "Thin list of available days"
          }
        }
      }
    },
    "/ops.json": {
      "get": {
        "summary": "Pipeline / ops snapshot",
        "responses": {
          "200": {
            "description": "Build timestamp, counts, stories, telegram"
          }
        }
      }
    }
  }
}